# macpro-ai-tools configuration.
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# The gateway reports which providers are configured and refuses the rest.

# --- Model provider API keys (leave blank if unused) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Debian side reached by the MCP server (defaults shown; override if needed) ---
MACPRO_LINUX_HOST=192.168.1.124
MACPRO_LINUX_USER=macpro
