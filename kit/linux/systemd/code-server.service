[Unit]
Description=code-server - VS Code in a browser (UI runs on your laptop, work happens here)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=macpro
Group=macpro
Environment=HOME=/home/macpro
WorkingDirectory=/home/macpro
ExecStart=/usr/local/bin/code-server
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
