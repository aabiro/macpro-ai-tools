# Install as /etc/ai-cockpit/env, owned root:aigw, mode 0640.
# Both ai-gateway.service and cockpit-web.service read it, so the two consoles
# share one set of credentials. Empty values are reported by /health as
# "providers_configured: []" and requests for that provider are refused.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
