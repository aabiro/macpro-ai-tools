#!/bin/bash
# lion-provision -- install the AI cockpit inside the Lion VM, once.
#
# WHY THIS IS A ONE-OFF AND NOT A PER-SESSION STEP
#   The VM's disk is a real qcow2 overlay, not a scratch filesystem. Anything
#   installed here survives `lion-vm stop` and every later `lion-vm start`.
#   Run this once, take a snapshot, and the guest is permanently equipped.
#   The only thing that undoes it is `lion-vm reset`, which deliberately goes
#   back to the bare disk -- and `lion-vm restore` puts it back.
#
#   Nothing here touches Lion's physical disk. The VM writes to the overlay
#   only; the real Lion install still has no cockpit and no Remote Login.
#
#     lion-provision                       # gateway on the VM host
#     lion-provision http://192.168.1.9:8081
#
set -u

GATEWAY="${1:-http://10.0.2.2:8081}"   # 10.0.2.2 is the host, over QEMU user-net
KIT="${KIT:-/usr/local/share/doc/macpro/kit}"
DEST="/Users/Shared/ai-cockpit"
SRC="/Users/Shared/ai-cockpit-src"

fail=0
step () { printf '\n== %s\n' "$1"; }
ok   () { printf '   ok    %s\n' "$1"; }
bad  () { printf '   FAIL  %s\n' "$1"; fail=$((fail+1)); }

command -v lion    >/dev/null || { echo "lion is not installed" >&2; exit 1; }
command -v lion-cp >/dev/null || { echo "lion-cp is not installed" >&2; exit 1; }
[ -d "$KIT/macos-lion" ] || { echo "no kit at $KIT/macos-lion (set KIT=)" >&2; exit 1; }

step "Lion VM is up"
if ! lion true >/dev/null 2>&1; then
    echo "   starting it..."
    lion-vm start >/dev/null 2>&1
    lion-vm wait  >/dev/null 2>&1
fi
if lion true >/dev/null 2>&1; then ok "guest answers"; else bad "guest does not answer"; exit 1; fi

step "copy the cockpit sources into the guest"
lion "mkdir -p $SRC" >/dev/null 2>&1
for f in g5ai.py cockpit.py g5_config.py g5_doctor.py g5_assist.py retro_port.py install.sh; do
    if [ -f "$KIT/macos-lion/$f" ]; then
        if lion-cp "$KIT/macos-lion/$f" "lion:$SRC/" >/dev/null 2>&1; then ok "$f"; else bad "$f"; fi
    else
        bad "$f missing from the kit"
    fi
done
# g5cli.py may come from the kit, or already be present in the guest -- the
# Lion install shipped with a copy at /Users/Shared/g5cli.py. Either is fine;
# what matters is that $DEST/g5cli.py exists before the wrappers are written.
if [ -f "$KIT/shared/g5cli.py" ]; then
    lion-cp "$KIT/shared/g5cli.py" "lion:$SRC/g5cli.py" >/dev/null 2>&1 \
        && ok "g5cli.py (from the kit)" || bad "g5cli.py copy failed"
elif lion "test -f /Users/Shared/g5cli.py" >/dev/null 2>&1; then
    lion "cp /Users/Shared/g5cli.py $SRC/g5cli.py" >/dev/null 2>&1 \
        && ok "g5cli.py (already in the guest)" || bad "g5cli.py copy inside guest failed"
else
    bad "g5cli.py found neither in the kit nor in the guest"
fi

step "run the installer inside Lion"
out=$(lion "cd $SRC && /bin/bash ./install.sh 2>&1" 2>&1)
if printf '%s' "$out" | grep -q "Installed. Commands available"; then
    ok "install.sh completed"
elif lion "test -x $DEST/bin/g5-config" >/dev/null 2>&1; then
    ok "cockpit already installed in the guest; installer not needed"
else
    bad "install.sh did not report success and no cockpit is present"
    printf '%s\n' "$out" | sed 's/^/        /' | tail -12
fi

step "add the three chat commands, which install.sh does not cover"
# Dispatch is on argv[0], but g5cli.py also accepts the tool name as the first
# argument -- so a wrapper is safer than a symlink, because it can also pin
# PYTHONPATH the way install.sh's own wrappers do.
lion "cp $SRC/g5cli.py $DEST/g5cli.py && chmod 644 $DEST/g5cli.py" >/dev/null 2>&1
# Guard: writing wrappers that point at a missing g5cli.py would REPLACE working
# ones with broken ones. The Lion install already ships these three commands, so
# a failed copy must not be allowed to clobber them.
if ! lion "test -s $DEST/g5cli.py" >/dev/null 2>&1; then
    bad "g5cli.py is not in $DEST -- leaving the existing g5-codex/copilot/gemini alone"
else
for tool in codex copilot gemini; do
    lion "cat > $DEST/bin/g5-$tool <<'WRAP'
#!/bin/bash
# AI Cockpit launcher -- generated by lion-provision
export PYTHONPATH=\"$DEST:\${PYTHONPATH:-}\"
exec /usr/bin/python \"$DEST/g5cli.py\" $tool \"\$@\"
WRAP
chmod 755 $DEST/bin/g5-$tool" >/dev/null 2>&1
    if lion "test -x $DEST/bin/g5-$tool" >/dev/null 2>&1; then ok "g5-$tool"; else bad "g5-$tool"; fi
done
fi

step "point the guest at the gateway"
lion "cat > $DEST/config.json <<'JSON'
{
  \"gateway\": \"$GATEWAY\",
  \"provider\": \"gemini\",
  \"model\": \"\",
  \"max_tokens\": 2048,
  \"timeout\": 120
}
JSON
chmod 666 $DEST/config.json" >/dev/null 2>&1
got=$(lion "cat $DEST/config.json" 2>/dev/null | tr -d ' \n')
if printf '%s' "$got" | grep -q "\"gateway\":\"$GATEWAY\""; then
    ok "gateway = $GATEWAY"
else
    bad "gateway not written (got: $(printf '%s' "$got" | cut -c1-80))"
fi

step "PATH for interactive logins"
# `lion` supplies PATH for non-interactive commands. An interactive login runs
# root's shell, which is /bin/sh here -- so .profile, not .bash_profile.
lion "cat > /var/root/.profile <<'PROF'
# Added by lion-provision. /bin/sh reads .profile, not .bash_profile, which is
# why the installer's own .bash_profile line is not enough for this account.
PATH=\"$DEST/bin:/usr/local/bin:\$PATH\"
export PATH
PROF
chmod 644 /var/root/.profile" >/dev/null 2>&1
lion "grep -q ai-cockpit /var/root/.profile" >/dev/null 2>&1 \
    && ok "/var/root/.profile" || bad "/var/root/.profile"

step "verify every command actually runs"
# Run each one for real. A file existing is not evidence that it works.
check () {
    local label="$1" cmd="$2" expect="$3"
    local o; o=$(lion "$cmd" 2>&1)
    if printf '%s' "$o" | grep -qi -- "$expect"; then
        ok "$label"
    else
        bad "$label -- expected /$expect/, got: $(printf '%s' "$o" | tr '\n' ' ' | cut -c1-100)"
    fi
}
check "g5-config show"   "g5-config show"           "gateway"
check "g5-doctor"        "g5-doctor 2>&1 | head -20" "."
check "g5-codex --help"  "g5-codex --help 2>&1"      "usage"
check "g5-gemini --help" "g5-gemini --help 2>&1"     "usage"
check "retro-port"       "retro-port --help 2>&1"    "."
check "cockpit present"  "test -f $DEST/cockpit.py && echo yes" "yes"

step "verify the guest can reach the gateway"
check "gateway health" \
      "/usr/bin/python -c \"import urllib2; print(urllib2.urlopen('$GATEWAY/health', timeout=10).read())\"" \
      "\"status\""

printf '\n'
if [ "$fail" -eq 0 ]; then
    echo "All checks passed. Take a snapshot so this survives a reset:"
    echo "    lion-vm stop && lion-vm snapshot && lion-vm start"
    exit 0
fi
echo "$fail check(s) FAILED -- see above. Nothing was snapshotted."
exit 1
